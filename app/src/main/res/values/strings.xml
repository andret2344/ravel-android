<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="en">
    <!--
        The default locale, and English. Every other language is a values-<code> beside this one,
        never a string added here: a phone whose language the app does not speak falls back to this
        file, so a Polish string left in it would surface in the middle of an English screen - which
        is exactly how this file came to be half Polish once.
    -->
    <string name="app_name" translatable="false">Ravel</string>

    <!--
        Five labels across a phone, so every one of them is a short word. A label that ellipsises is
        not a label, and the shortest true word beats the exact one: "Options" is what the tab is
        for, and it fits where "Settings" starts losing its last letters on a narrow screen.
    -->
    <string name="tab_stats">Stats</string>
    <string name="tab_daily">Daily</string>
    <string name="tab_main">Game</string>
    <string name="tab_shop">Shop</string>
    <string name="tab_settings">Options</string>

    <!-- The board screen itself, which is the same screen in both game modes. -->
    <string name="board_generating">Building the board…</string>
    <string name="board_slow">This board is a big one and takes longer to build. You don\'t have to wait here: it keeps building while you play the daily challenge.</string>
    <string name="board_slow_daily">Play the daily challenge</string>
    <string name="board_failed">Could not build a board.</string>
    <string name="board_retry">Try again</string>
    <string name="board_description">Board %1$d by %2$d</string>
    <string name="board_close">Close the board</string>

    <string name="daily_title">Daily challenge</string>
    <string name="daily_play">Play today\'s board</string>
    <string name="daily_reviewing">Already solved</string>

    <!--
        The question the game opens with while today's board is still unsolved, in its two forms:
        an untouched board is an invitation, a half-finished one is a reminder, and the second is
        the stronger of the two because something is already owed.
    -->
    <string name="daily_prompt_title">Today\'s board is waiting</string>
    <string name="daily_prompt_body">You have not solved today\'s daily challenge yet. Play it now?</string>
    <string name="daily_prompt_play">Play</string>
    <string name="daily_prompt_resume_title">Today\'s board is half done</string>
    <string name="daily_prompt_resume_body">You left today\'s daily challenge part-way through. Finish it now?</string>
    <string name="daily_prompt_remind">Ask me every time</string>
    <string name="daily_prompt_later">Not now</string>

    <!--
        The main mode: one level at a time, in order. The number is always formatted in rather than
        appended, because "Level 7" is a name and the word in front of it moves in other languages.
    -->
    <string name="main_title">Game</string>
    <string name="level_number">Level %1$d</string>
    <!-- The board's shape, under its number: "6 × 6". -->
    <string name="level_size">%1$d × %2$d</string>
    <string name="level_play">Play</string>
    <string name="level_resume">Continue</string>
    <plurals name="levels_done">
        <item quantity="one">%1$d level completed</item>
        <item quantity="other">%1$d levels completed</item>
    </plurals>
    <!-- Spoken descriptions for the strip of levels, which on screen are numbers alone. -->
    <string name="level_rung_done">Level %1$d, completed</string>
    <string name="level_rung_current">Level %1$d, now playing</string>
    <string name="level_rung_locked">Level %1$d, locked</string>

    <!-- Shown the moment a level is beaten, with the two ways on. -->
    <string name="level_done_title">Level %1$d solved!</string>
    <!-- The button names where it goes, because on a ladder that is the whole offer. -->
    <string name="level_next">Next: %1$d</string>
    <string name="level_menu">Menu</string>

    <!-- Shown the moment the last word is found, with what the board paid. -->
    <string name="done_title">Solved!</string>
    <!-- A gain, so it carries its sign: "+20". -->
    <string name="done_gained">+%1$d</string>
    <string name="done_for_board">Board</string>
    <!-- The count and its noun, which are separate everywhere else and one sentence here. -->
    <string name="done_exit">Done</string>

    <!--
        The streak. Amounts are never formatted in as bare numbers: they go through
        coins_balance first and arrive here as text, because the noun after the number is declined
        by it in Polish and in most of the languages after it.
    -->
    <string name="streak_title">Weekly streak</string>
    <string name="streak_none">No streak yet</string>
    <!-- The noun under the big count, so it carries no number of its own. -->
    <plurals name="streak_days">
        <item quantity="one">day in a row</item>
        <item quantity="other">days in a row</item>
    </plurals>
    <!-- The name on every rung of the ladder. -->
    <string name="streak_day">Day %1$d</string>
    <!-- Spoken descriptions for the seven rungs, which on screen are numbers alone. -->
    <string name="streak_rung_taken">Day %1$d, %2$s, collected</string>
    <string name="streak_rung_offered">Day %1$d, %2$s, today</string>
    <string name="streak_rung_ahead">Day %1$d, %2$s</string>

    <string name="calendar_previous">Previous month</string>
    <string name="calendar_next">Next month</string>
    <string name="calendar_day_solved">%1$d, solved</string>
    <string name="calendar_day_today">%1$d, today, not solved yet</string>
    <string name="calendar_day_missed">%1$d, missed</string>
    <string name="calendar_day_future">%1$d</string>

    <!-- The card under the calendar: one day, spelled out. -->
    <string name="day_pick">Pick a day to see how it went.</string>
    <plurals name="day_stat_letters">
        <item quantity="one">letter</item>
        <item quantity="other">letters</item>
    </plurals>
    <plurals name="day_stat_words">
        <item quantity="one">word</item>
        <item quantity="other">words</item>
    </plurals>
    <string name="day_stat_time">time</string>
    <string name="day_open_solved">See the board</string>

    <!-- Sharing a solved day. The layout below is a resource rather than something assembled in
         code because it is the one string in this app that gets read outside it, and a translator
         has to be able to move the separators and the line breaks.

         Placeholders, in order: date, language code, grid width (used twice, since boards are
         square), the row of squares, the word count with its noun, the clock, and the link.

         The squares themselves are not here. They are not language, and two locales disagreeing
         about which colour means "found it" would make two players' results incomparable, which is
         the one thing the row exists to be. See DailyShare. -->
    <string name="share_action">Share result</string>
    <plurals name="share_words">
        <item quantity="one">%1$d word</item>
        <item quantity="other">%1$d words</item>
    </plurals>
    <string name="share_text">Ravel · %1$s · %2$s · %3$d×%3$d\n%4$s\n%5$s · %6$s\n\n%7$s</string>
    <!-- A proper name and a URL: required verbatim, so neither is offered for translation. -->
    <string name="share_subject" translatable="false">Ravel</string>
    <string name="share_link" translatable="false">https://play.google.com/store/apps/details?id=eu.andret.ravel</string>

    <!-- The three tiles under the streak. Labels are one word: they sit in a square a third of the
         screen wide, and a wrapped label reads as two lines of nothing in particular. -->
    <string name="tile_play">Play</string>
    <string name="tile_play_caption">today</string>
    <string name="tile_play_resume">Continue</string>
    <string name="tile_play_done">Review</string>
    <string name="tile_play_done_caption">done</string>
    <string name="tile_calendar">Calendar</string>
    <!-- Not built yet, and locked rather than hidden: see LockedTile. -->
    <string name="tile_leaderboards">Ranking</string>
    <string name="tile_locked_caption">soon</string>

    <!--
        The three groups of tiles. The first two are about the daily challenge alone; the third
        counts both modes, which is why it says so rather than being left to be assumed.
    -->
    <string name="stats_section_daily">Daily challenge</string>
    <string name="stats_section_hints">Hints bought</string>
    <string name="stats_section_total">Daily and game together</string>

    <!-- Labels under the numbers, so none of them carries a number of its own. -->
    <string name="stats_solved">days solved</string>
    <!-- The best run ever made, not the one being made now: that lives on the daily tab. -->
    <string name="stats_longest">best streak</string>
    <string name="stats_letters">letters</string>
    <string name="stats_words">words</string>
    <string name="stats_boards">boards solved</string>
    <string name="stats_found">words found</string>
    <string name="stats_total_time">time on boards</string>
    <!--
        Under the last tile, because the main mode keeps a separate ladder per language and these
        numbers do not. Without it "boards solved" reads as the count for whichever language is being
        played, which is a smaller number and the one the game tab is already showing.
    -->
    <string name="stats_all_languages">Counted across every language.</string>

    <string name="dialog_close">Close</string>

    <string name="hint_letter">Letter</string>
    <string name="hint_word">Word</string>

    <!--
        The running tally under the board, and the same two counts on the day card afterwards. The
        counts are plurals with the number in them; the labels under the big numbers on the card are
        plurals without it, because the number is already above them.
    -->
    <string name="hints_used">%1$s · %2$s</string>
    <plurals name="hints_letters">
        <item quantity="one">%1$d letter</item>
        <item quantity="other">%1$d letters</item>
    </plurals>
    <plurals name="hints_words">
        <item quantity="one">%1$d word</item>
        <item quantity="other">%1$d words</item>
    </plurals>

    <!--
        The player's coins, spoken rather than shown. Every coin figure on screen is a figure and
        the coin drawable next to it - see CoinAmount - so this is what a screen reader is given in
        place of the bare digits, and it is the only thing that still needs the noun. Putting it
        back on screen beside the icon would be the label read twice, in four Polish forms the icon
        does not need.
    -->
    <plurals name="coins_balance">
        <item quantity="one">%1$d coin</item>
        <item quantity="other">%1$d coins</item>
    </plurals>

    <string name="shop_title">Shop</string>

    <!--
        The ad tile, which is the only place in the game an ad can be started.

        Solving used to have a card of its own here, listing what a finished board pays. It is gone:
        the shop is where a player comes to get coins now, and "keep playing the game you are
        already playing" is not something they came here to be told. The reward for solving has not
        changed - see Rewards.FOR_COMPLETING - it is simply not news.

        Every line is written to be readable before anything happens: what it pays, how many are
        left, and - when there is nothing to offer - which of the several reasons it is.
    -->
    <string name="shop_earn_ads">Watch an ad</string>
    <!-- Digits and a plus sign; there is nothing in it to translate. -->
    <string name="shop_ad_reward" translatable="false">+%1$d</string>
    <string name="shop_ad_left_today">%1$d/%2$d today</string>
    <string name="shop_ad_none_left">Come back tomorrow.</string>
    <string name="shop_ad_loading">Finding an ad…</string>
    <string name="shop_ad_unavailable">No ad right now. Tap to try again.</string>
    <string name="shop_ad_blocked">Ads are off, because of the privacy choice you made. You can change it under %1$s.</string>

    <string name="shop_buy">Buy coins</string>
    <string name="shop_coming_soon">Coming soon.</string>
    <string name="shop_prices">A letter costs %1$d, a whole word %2$d.</string>

    <!--
        The options tab. One setting, so the group heading carries the whole screen.

        The languages themselves are never listed here: each is named in its own language, taken from
        the platform, because a player hunting for English on a Polish screen is hunting for the word
        "English" - see SettingsScreen.
    -->
    <string name="settings_language">Language</string>
    <!--
        The trailing half of the row that opens the picker. The leading half is the language itself,
        so this is what makes the row read as a control rather than as a fact about the game.

        There is no longer a "Phone language" option. A player who has never chosen is on the
        phone's language anyway - English where the game does not speak theirs - so the row said
        nothing the default did not already do, and it was a permanent third entry in a list that
        grows by one every time the game learns a language.
    -->
    <string name="settings_change">Change</string>
    <!-- What the setting reaches, said once, because it reaches further than a player would guess. -->
    <string name="settings_language_note">Sets the words on the boards and the language of the game.</string>

    <!--
        Asked only when there is a board part-way through, which is the only time switching costs
        anything. It says what is lost and does not offer to undo it: the coins spent on hints are
        spent, and a language switch that refunded them would be a way to buy a word and take it
        back.
    -->
    <string name="settings_switch_title">Change the language?</string>
    <string name="settings_switch_body">The board you have started is in the language you are playing now, so it will be set up again from the beginning. Your level, your streak and your coins stay - the hints you have already paid for on this board do not.</string>
    <string name="settings_switch_confirm">Change</string>
    <string name="settings_switch_cancel">Keep it</string>

    <!--
        The vibration switch. "Feedback" heads the group rather than "Vibration", because the group
        is about what the game says back to a touch and the vibration is only how it says it today.

        The note is the important half. This switch can only ever take haptics away: with it on, the
        phone's own touch-feedback setting still decides, so a player who turned that off feels
        nothing here and would otherwise go looking for a fault in the game. It names the system
        setting rather than linking to it - every manufacturer buries it somewhere different, and a
        button that opened the wrong screen would be worse than a sentence that says what to look for.
    -->
    <string name="settings_feedback">Feedback</string>
    <string name="settings_haptics">Vibration on the board</string>
    <string name="settings_haptics_note">A short vibration for each letter, a word found and a finished board. Your phone\'s own touch feedback setting has to be on as well.</string>

    <!--
        Where the words come from, listed on the settings tab and opened one at a time.

        Everything below marked translatable="false" is either a proper name or a licence notice.
        The names are not translated because they are what the resources are called; the notices are
        not translated because CC BY 4.0 and the WordNet licence both say what has to appear, and an
        unofficial rendering of a required notice is not the notice. The two Creative Commons entries
        carry the statement that the material was modified, which that licence requires and which is
        the one part of these paragraphs that is about this game rather than about the source.
    -->
    <!--
        Only shown where the consent SDK says a form is required - see AdConsent. A player who was
        never asked has nothing to change, and a row that opens a form which reports "nothing to
        show" is worse than no row at all.
    -->
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_ads">Ad privacy choices</string>
    <string name="settings_privacy_note">Change what ads on this device are allowed to use. Ads are only ever shown when you ask for one in the shop.</string>

    <string name="settings_sources">Word sources</string>
    <string name="settings_sources_note">The dictionaries are built from public word lists and corpora. Tap a source to see its licence.</string>
    <string name="licence_open">Open the licence</string>
    <string name="licence_back">Back</string>

    <string name="settings_licence">Licence</string>

    <string name="licence_name_cc_by" translatable="false">CC BY 4.0</string>
    <string name="licence_name_bsd" translatable="false">BSD 2-clause</string>
    <string name="licence_name_wordnet" translatable="false">WordNet licence</string>
    <string name="licence_name_public_domain" translatable="false">Public domain</string>
    <string name="licence_name_unrestricted" translatable="false">No restrictions</string>
    <string name="licence_name_polyform" translatable="false">PolyForm Noncommercial 1.0.0</string>

    <string name="licence_sjp_source" translatable="false">SJP.PL word list</string>
    <string name="licence_sjp_notice" translatable="false">The Polish dictionary is based on the SJP.PL Dictionary (https://sjp.pl), made available under the Creative Commons Attribution 4.0 International licence. The material has been modified: a subset of words was selected and ordered by frequency.</string>

    <string name="licence_kwjp_source" translatable="false">KWJP100</string>
    <string name="licence_kwjp_notice" translatable="false">Polish word frequencies come from the KWJP100 frequency lists — Corpus of Contemporary Polish, Institute of Computer Science, Polish Academy of Sciences (https://kwjp.pl), made available under the Creative Commons Attribution 4.0 International licence. The material has been modified: a subset of words was selected and ordered by frequency.</string>

    <string name="licence_polimorf_source" translatable="false">PoliMorf</string>
    <string name="licence_polimorf_notice" translatable="false">Polish lemmatisation is based on PoliMorf (Linguistic Engineering Group, Institute of Computer Science PAS, and the Grammatical Dictionary of Polish team), licensed under the BSD 2-clause licence.</string>

    <string name="licence_wordnet_source" translatable="false">WordNet 3.0</string>
    <string name="licence_wordnet_notice" translatable="false">English lemmatisation is based on WordNet 3.0, Princeton University (https://wordnet.princeton.edu). WordNet 3.0 Copyright 2006 by Princeton University. All rights reserved. Used under the terms of the WordNet licence.</string>

    <string name="licence_enable_source" translatable="false">ENABLE word list</string>
    <string name="licence_enable_notice" translatable="false">The English word list is ENABLE, released by its author into the public domain: “The ENABLE master word list, WORD.LST, is herewith formally released into the Public Domain.”</string>

    <string name="licence_oanc_source" translatable="false">Open American National Corpus</string>
    <string name="licence_oanc_notice" translatable="false">English word frequencies are computed from the Open American National Corpus (https://anc.org), which is distributed with no restrictions on use, commercial or otherwise.</string>

    <string name="licence_ravel_source" translatable="false">Ravel</string>
    <!--
        Translated, unlike the six notices above: no one else's required wording is being reproduced
        here, so a Polish player reads this one in Polish. The copyright line stays as it is in every
        locale - it is a name and a year, and PolyForm asks for it to travel with the software.
    -->
    <string name="licence_ravel_notice">Ravel is published under the PolyForm Noncommercial License 1.0.0. The source code is at https://github.com/andret2344/ravel-android and may be read, built and changed for any noncommercial purpose; commercial use is not licensed. Copyright 2026 Andret2344. The word lists are not covered by these terms — they are listed above, under the licences of the projects they come from.</string>
</resources>
