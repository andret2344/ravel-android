<?xml version="1.0" encoding="utf-8"?>
<!--
    The languages the app speaks. Declaring them puts Ravel in the system's per-app language
    picker on Android 13 and later.

    From API 33 that picker and the one in the options tab are one setting: the game stores its
    choice as the system's per-app language (LocaleManager) and reads it back from there, so a
    language picked in either place is the language in both. See LanguageSettings. Below 33 the
    system has no such picker and the game's own choice is the only one.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en-US" />
    <locale android:name="pl-PL" />
</locale-config>
