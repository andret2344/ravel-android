<!--
    A padlock, drawn rather than typed.

    Every other icon in the game is a character, because the shapes it needs exist as characters.
    A padlock does not: the Unicode one is a colour emoji on most phones, which would put a yellow
    pictogram on a tile whose whole job is to look switched off. A vector takes the tint it is given
    and dims with the content around it.

    The one drawable the app draws itself, so it is deliberately the Material shape and not a
    reinvention - a lock is a symbol the player already knows, and an original one is only a lock
    the player has to learn.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- White and untinted here: Compose's Icon paints it in the content colour of whatever it is
         put inside, and a tint baked in would fight that rather than help it. -->
    <path
        android:fillColor="@android:color/white"
