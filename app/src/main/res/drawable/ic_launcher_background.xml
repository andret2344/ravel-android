<?xml version="1.0" encoding="utf-8"?>
<!--
    A flat surface and nothing else: the adaptive-icon background is reprojected and parallaxed by
    some launchers, and anything with detail in it fights the foreground once it moves. The colour
    is the board's own surfaceVariant, so the icon and the first screen agree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#EDE0D3"
        android:pathData="M0,0 h108 v108 h-108 z" />
</vector>
