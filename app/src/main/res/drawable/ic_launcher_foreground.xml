<?xml version="1.0" encoding="utf-8"?>
<!--
    Ravel launcher foreground.

    Drawn in the 108dp canvas the adaptive icon expects, but every shape sits inside the central
    72dp circle, so no mask - circle, squircle, teardrop - can clip a corner off the grid.

    The motif is the board itself: a word is a path of orthogonally adjacent cells, so five cells
    joined by a ribbon are the game in one shape. Proportions are the board's own (BoardStyle):
    corner radius 0.18 of a cell, ribbon 0.55 of a cell. The unsolved cells stay in the board's
    warm tone so the ribbon is the only thing the eye lands on first.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cells not yet part of a found word. -->
    <path
        android:fillColor="#D9A57C"
        android:pathData="M65.5,31 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#D9A57C"
        android:pathData="M33.5,47 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#D9A57C"
        android:pathData="M65.5,47 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#D9A57C"
        android:pathData="M33.5,63 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />

    <!-- The ribbon, beneath the cells it joins, exactly as BoardPainter draws it. -->
    <path
        android:pathData="M38,38 L54,38 L54,70 L70,70"
        android:strokeColor="#4E9C74"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The found word. -->
    <path
        android:fillColor="#4E9C74"
        android:pathData="M33.5,31 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#4E9C74"
        android:pathData="M49.5,31 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#4E9C74"
        android:pathData="M49.5,47 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
    <path
        android:fillColor="#4E9C74"
        android:pathData="M49.5,63 h9 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 h-9 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />
